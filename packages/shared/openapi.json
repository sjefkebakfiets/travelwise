{
  "openapi": "3.1.0",
  "info": {
    "title": "Travelwise Phase 1 contract",
    "version": "0.2.0",
    "description": "Implemented mobile authentication, private trips and idempotent GPS ingestion. Web sessions and Android client integration remain planned."
  },
  "paths": {
    "/api/health": {
      "get": {
        "responses": {
          "200": {
            "description": "Web process responds; does not verify PostgreSQL"
          }
        }
      }
    },
    "/api/gps/batch": {
      "post": {
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "description": "Authenticated transactional ingestion. Ownership is derived from the bearer token. Identical point retries are acknowledged; conflicting IDs return 409.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GPSBatch"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Acknowledged stored point IDs, including identical retries"
          },
          "400": {
            "description": "Invalid batch"
          },
          "401": {
            "description": "Missing or expired token"
          },
          "404": {
            "description": "Trip not found or not owned"
          },
          "409": {
            "description": "Point ID conflicts with stored payload"
          },
          "413": {
            "description": "Batch exceeds 500 points or 256 KiB"
          },
          "429": {
            "description": "Rate limit exceeded"
          }
        }
      }
    },
    "/api/auth/mobile/login": {
      "post": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MobileLogin"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Mobile tokens",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MobileSession"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Invalid credentials or token"
          },
          "429": {
            "description": "Rate limited"
          }
        }
      }
    },
    "/api/auth/mobile/refresh": {
      "post": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MobileRefresh"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Mobile tokens",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MobileSession"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Invalid credentials or token"
          },
          "429": {
            "description": "Rate limited"
          }
        }
      }
    },
    "/api/auth/mobile/logout": {
      "post": {
        "description": "Revoke the current device session",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Not found or not owned"
          },
          "429": {
            "description": "Rate limited"
          },
          "500": {
            "description": "Internal failure"
          }
        }
      }
    },
    "/api/trips": {
      "get": {
        "description": "List private trips",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Not found or not owned"
          },
          "429": {
            "description": "Rate limited"
          },
          "500": {
            "description": "Internal failure"
          }
        },
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ]
      },
      "post": {
        "description": "Create a private trip",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "201": {
            "description": "Created private trip"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Unauthorized"
          },
          "429": {
            "description": "Rate limited"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TripInput"
              }
            }
          }
        }
      }
    },
    "/api/trips/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "get": {
        "description": "Get an owned trip",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Not found or not owned"
          },
          "429": {
            "description": "Rate limited"
          },
          "500": {
            "description": "Internal failure"
          }
        }
      },
      "patch": {
        "description": "Update an owned trip",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Not found or not owned"
          },
          "429": {
            "description": "Rate limited"
          },
          "500": {
            "description": "Internal failure"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TripPatch"
              }
            }
          }
        }
      },
      "delete": {
        "description": "Delete an owned trip and its GPS history transactionally",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Not found or not owned"
          },
          "409": {
            "description": "Photos must be removed first"
          },
          "429": {
            "description": "Rate limited"
          },
          "500": {
            "description": "Internal failure"
          }
        }
      }
    },
    "/api/trips/{id}/gps": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "get": {
        "description": "Paginated original GPS points",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Not found or not owned"
          },
          "429": {
            "description": "Rate limited"
          },
          "500": {
            "description": "Internal failure"
          }
        },
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ]
      }
    },
    "/api/trips/{id}/route": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "get": {
        "description": "Recorded route GeoJSON, limited to 10000 raw points",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Not found or not owned"
          },
          "422": {
            "description": "Use a smaller UTC range"
          },
          "429": {
            "description": "Rate limited"
          },
          "500": {
            "description": "Internal failure"
          }
        },
        "parameters": [
          {
            "name": "from",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "to",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          }
        ]
      }
    },
    "/api/devices": {
      "get": {
        "description": "List up to 100 owned device sessions",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Not found or not owned"
          },
          "429": {
            "description": "Rate limited"
          },
          "500": {
            "description": "Internal failure"
          }
        }
      }
    },
    "/api/devices/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "delete": {
        "description": "Revoke an owned device session",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Not found or not owned"
          },
          "429": {
            "description": "Rate limited"
          },
          "500": {
            "description": "Internal failure"
          }
        }
      }
    },
    "/api/ready": {
      "get": {
        "responses": {
          "200": {
            "description": "Database schema is available"
          },
          "503": {
            "description": "Database or schema unavailable"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "GPSBatch": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tripId",
          "points"
        ],
        "properties": {
          "tripId": {
            "type": "string",
            "format": "uuid"
          },
          "points": {
            "type": "array",
            "minItems": 1,
            "maxItems": 500,
            "items": {
              "$ref": "#/components/schemas/GPSPoint"
            }
          }
        }
      },
      "GPSPoint": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "segmentId",
          "latitude",
          "longitude",
          "timestamp",
          "accuracy"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "segmentId": {
            "type": "string",
            "format": "uuid"
          },
          "latitude": {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          },
          "longitude": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$"
          },
          "accuracy": {
            "type": "number",
            "minimum": 0
          },
          "altitude": {
            "type": [
              "number",
              "null"
            ]
          },
          "speed": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "bearing": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "exclusiveMaximum": 360
          }
        }
      },
      "MobileSession": {
        "type": "object",
        "required": [
          "accessToken",
          "refreshToken",
          "tokenType",
          "expiresIn",
          "deviceId"
        ],
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "refreshToken": {
            "type": "string"
          },
          "tokenType": {
            "const": "Bearer"
          },
          "expiresIn": {
            "const": 900
          },
          "deviceId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "MobileLogin": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "email",
          "password",
          "deviceName"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "deviceName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        }
      },
      "MobileRefresh": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "refreshToken"
        ],
        "properties": {
          "refreshToken": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$"
          }
        }
      },
      "TripInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "description": {
            "type": "string",
            "maxLength": 10000
          },
          "status": {
            "enum": [
              "PLANNED",
              "ACTIVE",
              "COMPLETED"
            ]
          },
          "timezone": {
            "type": "string",
            "description": "IANA timezone"
          },
          "startsAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "endsAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "countries": {
            "type": "array",
            "maxItems": 250,
            "items": {
              "type": "string",
              "pattern": "^[A-Z]{2}$"
            }
          }
        }
      },
      "TripPatch": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "description": {
            "type": "string",
            "maxLength": 10000
          },
          "status": {
            "enum": [
              "PLANNED",
              "ACTIVE",
              "COMPLETED"
            ]
          },
          "timezone": {
            "type": "string",
            "description": "IANA timezone"
          },
          "startsAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "endsAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "countries": {
            "type": "array",
            "maxItems": 250,
            "items": {
              "type": "string",
              "pattern": "^[A-Z]{2}$"
            }
          }
        }
      }
    }
  }
}